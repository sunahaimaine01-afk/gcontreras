# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EMAIL NOTIFICATIONS (Resend Transactional Email)
# Add your Resend API key from https://resend.com to enable instant real email delivery on each customer booking.
RESEND_API_KEY=""

# The business owner's email address where booking notifications will be sent
BOOKING_NOTIFICATION_EMAIL="sunahaimaine01@gmail.com"

# The sender address configured in Resend (default: onboarding@resend.dev)
BOOKING_FROM_EMAIL="G Contreras Car Wash <onboarding@resend.dev>"

# OWNER ACCESS PIN
# Secret PIN to access the protected booking management dashboard (Default: contreras2026)
OWNER_ADMIN_PIN="contreras2026"
